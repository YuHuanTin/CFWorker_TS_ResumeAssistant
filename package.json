{
  "name": "resume-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ResumeAssistant —— Typst 实时简历编辑器：左边写 Typst，右边毫秒级实时渲染，内置可接入任意 AI 的简历助手",
  "scripts": {
    "dev": "wrangler dev",
    "dev:ui": "vite",
    "deploy": "wrangler deploy",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p worker/tsconfig.json",
    "cf-typegen": "wrangler types"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0",
    "@myriaddreamin/typst.ts": "^0.7.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-typst": "^0.6.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "puppeteer-core": "^25.16.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14",
    "wrangler": "^4.158.0"
  }
}
